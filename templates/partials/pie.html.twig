{# Pie común. Datos: sitio.marca, sitio.pie #}
<footer class="pie_general pt-5 pb-4">
    <div class="container pt-lg-4">
        <div class="row g-5">
            <div class="col-lg-4">
                <img class="logo_marca_pie" src="{{ sitio.marca.logo_pie }}" alt="{{ sitio.marca.nombre }}">
                <p class="pie_texto mt-3">{{ sitio.pie.texto }}</p>
            </div>
            <div class="col-6 col-lg-3 offset-lg-1">
                <h2 class="pie_titulo mb-3">{{ sitio.pie.navegacion.titulo }}</h2>
                <ul class="pie_lista p-0 m-0">
                    {% for enlace in sitio.pie.navegacion.enlaces %}
                    <li>{% if enlace.url %}<a href="{{ enlace.url }}">{{ enlace.texto }}</a>{% else %}{{ enlace.texto }}{% endif %}</li>
                    {% endfor %}
                </ul>
            </div>
            <div class="col-6 col-lg-4">
                <h2 class="pie_titulo mb-3">{{ sitio.pie.informacion.titulo }}</h2>
                <ul class="pie_lista p-0 m-0">
                    {% for enlace in sitio.pie.informacion.enlaces %}
                    <li>{% if enlace.url %}<a href="{{ enlace.url }}">{{ enlace.texto }}</a>{% else %}{{ enlace.texto }}{% endif %}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="pie_legal mt-5 pt-4">
            <span>{{ sitio.pie.legal.copyright }}</span>
            <ul class="pie_legal_enlaces p-0 m-0">
                {% for enlace in sitio.pie.legal.enlaces %}
                <li><a href="{{ enlace.url }}">{{ enlace.texto }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
</footer>
